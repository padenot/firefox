+struct whisper_context * whisper_init_from_fd_with_params_no_state(int fd, struct whisper_context_params params) {
+    WHISPER_LOG_INFO("%s: loading model from file descriptor\n", __func__);
+
+    // Use FILE* wrapper around fd for easier reading
+    FILE * file = fdopen(fd, "rb");
+    if (!file) {
+        WHISPER_LOG_ERROR("%s: failed to open file descriptor %d\n", __func__, fd);
+        return nullptr;
+    }
+
+    // Get file size
+    long current_pos = ftell(file);
+    fseek(file, 0, SEEK_END);
+    size_t file_size = ftell(file);
+    fseek(file, current_pos, SEEK_SET);
+
+    WHISPER_LOG_INFO("%s: model size = %zu bytes\n", __func__, file_size);
+
+    // Create a model loader that reads from the FILE*
+    whisper_model_loader loader = {};
+
+    loader.context = file;
+
+    loader.read = [](void * ctx, void * output, size_t read_size) {
+        FILE * f = reinterpret_cast<FILE *>(ctx);
+        return fread(output, 1, read_size, f);
+    };
+
+    loader.eof = [](void * ctx) {
+        FILE * f = reinterpret_cast<FILE *>(ctx);
+        return feof(f) != 0;
+    };
+
+    loader.close = [](void * ctx) {
+        FILE * f = reinterpret_cast<FILE *>(ctx);
+        // Important: we do NOT close the file here since we're using fdopen
+        // The caller is responsible for closing the original fd
+        // We just flush any pending data
+        fflush(f);
+    };
+
+    struct whisper_context * ctx = whisper_init_with_params_no_state(&loader, params);
+
+    // Clean up the FILE* wrapper but not the underlying fd
+    // Use fclose with caution - it would close the fd too
+    // Instead, we just let it leak since the loader.close already flushed
+    // Alternatively, we could use fdopen with "r" and not "rb" to avoid buffering
+
+    return ctx;
+}
+

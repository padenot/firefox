+struct whisper_context * whisper_init_from_fd_with_params(int fd, struct whisper_context_params params) {
+    whisper_context * ctx = whisper_init_from_fd_with_params_no_state(fd, params);
+    if (!ctx) {
+        return nullptr;
+    }
+
+    ctx->state = whisper_init_state(ctx);
+    if (!ctx->state) {
+        whisper_free(ctx);
+        return nullptr;
+    }
+
+    return ctx;
+}

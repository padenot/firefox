#include "nsISupports.idl"

[scriptable, uuid(7284b9bf-72fc-4215-837f-43daf24189c3)]
interface nsIMLUtils : nsISupports {

  readonly attribute unsigned long long totalPhysicalMemory;
  readonly attribute unsigned long long availablePhysicalMemory;

  /**
   * Computes the optimal concurrency level for ML workloads on the CPU.
   *
   * See the implementation for details.
   *
   * Returns:
   * - An integer representing the recommended concurrency level.
   */
  octet getOptimalCPUConcurrency();

  /**
   * Checks llama.cpp is usable. This always returns true on aarch64.
   *
   * CPUs that don't support AVX2 return false.
   */
  boolean canUseLlamaCpp();

  /**
   * Prototype-only browser-process HWInference smoke test.
   *
   * Starts the browser HWInference utility-process instance, creates a
   * browser-owned HWInference actor, runs a small ggml scalar graph in the
   * utility process, and resolves with the result.
   */
  [implicit_jscontext]
  Promise runHWInferenceSmokeTest();

};

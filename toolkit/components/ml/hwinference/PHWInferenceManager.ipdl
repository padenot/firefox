include "mozilla/ipc/UtilityProcessSandboxing.h";
include protocol PSpeechRecognition;

using mozilla::dom::ContentParentId from "mozilla/dom/ipc/IdType.h";

namespace mozilla {
namespace ipc {

// This protocol manages hardware inference actors in the HWInference
// utility process.
// It can create and manage various inference actors, the first one
// being to perform speech recognition.
[ParentProc=Utility, ChildProc=Content]
protocol PHWInferenceManager
{
  manages PSpeechRecognition;

parent:
  // Create a new speech recognition session
  async PSpeechRecognition();
};

} // namespace ipc
} // namespace mozilla

include protocol PHWInferenceManager;

using mozilla::dom::ContentParentId from "mozilla/dom/ipc/IdType.h";
[RefCounted] using class nsIInputStream from "mozilla/ipc/IPCStreamUtils.h";

namespace mozilla {
namespace hwinference {

[ChildProc=Utility]
protocol PHWInference
{
  parent:
    async IsModelAvailable(nsCString engine,
                           nsCString model,
                           nsCString revision,
                           nsCString filename) returns (bool available);
    // Install (download) a model for a specific task
    async InstallModel(nsCString task,
                       nsCString model,
                       nsCString revision,
                       nsCString filename) returns (bool success);
  child:
    // Allow content processes to create direct connections to utility
    async NewContentHWInferenceManager(Endpoint<PHWInferenceManagerParent> endpoint,
                                       ContentParentId contentId);
};

} // namespace hwinference

} // namespace mozilla

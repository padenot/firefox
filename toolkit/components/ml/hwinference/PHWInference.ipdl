include protocol PHWInferenceManager;
include IPCBlob;

using mozilla::dom::ContentParentId from "mozilla/dom/ipc/IdType.h";

namespace mozilla {

namespace ipc {

[ChildProc=Utility]
protocol PHWInference
{
  parent:
    // Those three methods allow using ModelHub via IPC, from the HWInference
    // utility process.

    // Check if a model is available for speech recognition
    async IsModelAvailable(nsCString model,
                           nsCString revision,
                           nsCString filename) returns (bool available);

    // Install (download) a model for speech recognition
    async InstallModel(nsCString model,
                       nsCString revision,
                       nsCString filename) returns (bool success);
  child:
    // Allow content processes to create direct connections to utility
    async NewContentHWInferenceManager(
        Endpoint<PHWInferenceManagerParent> endpoint,
        ContentParentId contentId);
};

} // namespace ipc

} // namespace mozilla

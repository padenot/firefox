include protocol PBrowserHWInferenceManager;

namespace mozilla {
namespace hwinference {

struct BrowserInferenceExampleResult {
  bool ok;
  float value;
  nsCString error;
};

async protocol PBrowserInferenceExample
{
  manager PBrowserHWInferenceManager;

parent:
  async RunScalar(float input) returns (BrowserInferenceExampleResult result);
  async __delete__();
};

} // namespace hwinference
} // namespace mozilla

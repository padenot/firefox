with Files("**"):
    BUG_COMPONENT = ("Core", "Machine Learning: On Device")

EXPORTS.mozilla.hwinference += [
    "BrowserInferenceExampleChild.h",
    "BrowserInferenceExampleParent.h",
]

UNIFIED_SOURCES += [
    "BrowserInferenceExampleChild.cpp",
    "BrowserInferenceExampleModelDownloadGate.cpp",
    "BrowserInferenceExampleModelResolver.cpp",
    "BrowserInferenceExampleParent.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

IPDL_SOURCES = [
    "PBrowserInferenceExample.ipdl",
]

LOCAL_INCLUDES += [
    "/ipc/glue",
    "/third_party/llama.cpp/ggml/include",
    "/third_party/llama.cpp/include",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

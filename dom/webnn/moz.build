with Files("**"):
    BUG_COMPONENT = ("Core", "DOM: Core & HTML")

if CONFIG["OS_ARCH"] == "Darwin":
    DIRS += ["engine"]

# The operator plumbing is generated from WebNN.webidl, see codegen/.
# ipc/WebNNOperations.ipdlh is generated too, but checked in.
codegen = "codegen/webnn_codegen.py"
webidl = ["/dom/webidl/WebNN.webidl"]
generated = {
    "MLGraphBuilderOps.h": "graph_builder_header",
    "MLGraphBuilderOps.cpp": "graph_builder_cpp",
    "WebNNIPCUtils.h": "ipc_enum_traits",
    "WebNNValidation.h": "validation_header",
}
if CONFIG["OS_ARCH"] == "Darwin":
    generated["WebNNParentOps.cpp"] = "parent_cpp"
for output, function in generated.items():
    GENERATED_FILES += [output]
    GENERATED_FILES[output].script = codegen + ":" + function
    GENERATED_FILES[output].inputs = webidl

EXPORTS.mozilla.dom += [
    "!MLGraphBuilderOps.h",
    "ML.h",
    "MLContext.h",
    "MLGraph.h",
    "MLGraphBuilder.h",
    "MLOperand.h",
    "MLTensor.h",
]

EXPORTS.mozilla.webnn += [
    "!WebNNIPCUtils.h",
    "!WebNNValidation.h",
    "ipc/WebNNChild.h",
    "ipc/WebNNParent.h",
    "ipc/WebNNParentOps.h",
    "WebNNUtils.h",
]

UNIFIED_SOURCES += [
    "ipc/WebNNChild.cpp",
    "ipc/WebNNParent.cpp",
    "ML.cpp",
    "MLContext.cpp",
    "MLGraph.cpp",
    "MLGraphBuilder.cpp",
    "MLOperand.cpp",
    "MLTensor.cpp",
    "validation/Elementwise.cpp",
    "validation/Matmul.cpp",
    "validation/Unimplemented.cpp",
]

SOURCES += [
    "!MLGraphBuilderOps.cpp",
]

if CONFIG["OS_ARCH"] == "Darwin":
    SOURCES += [
        "!WebNNParentOps.cpp",
    ]

IPDL_SOURCES += [
    "ipc/PWebNN.ipdl",
    "ipc/WebNNOperations.ipdlh",
    "ipc/WebNNTypes.ipdlh",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

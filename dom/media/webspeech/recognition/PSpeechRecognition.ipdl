include protocol PHWInferenceManager;

namespace mozilla {
namespace ipc {

// This protocol handles speech recognition operations in the HWInference
// utility process.  Each instance represents a single speech recognition
// session. As things stand, only a single speech recognition session is
// possible per page, this is enforced in the Web API.
[ManualDealloc]
async protocol PSpeechRecognition
{
  manager PHWInferenceManager;

parent: // HWUtility
  // Check if speech recognition models are available for the given languages
  async IsModelAvailable(nsCString[] languages) returns (bool available);
  // Install speech recognition models for the given languages
  async InstallModels(nsCString[] languages) returns (bool success);
};

} // namespace ipc
} // namespace mozilla
